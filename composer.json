{
    "name": "ksfraser/ksf_fa_hrm",
    "description": "HRM Module for FrontAccounting - Employee management, org hierarchy, payroll, benefits",
    "type": "frontaccounting-module",
    "repositories": [
        {
            "type": "path",
            "url": "../ksfraser/html",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=7.3",
        "ksfraser/html": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\HRM\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
